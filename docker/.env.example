# Docker Compose environment for Remix.
# Copy this file to docker/.env (same folder as docker-compose.yml) and edit.

# --- MySQL (used by the mysql service; reference the same values in config.json) ---
MYSQL_ROOT_PASSWORD=remix_root_pw
MYSQL_DATABASE=remix
MYSQL_USER=remix
MYSQL_PASSWORD=remix_pw

# --- NodeLink (audio node) ---
# REQUIRED. Use the same value in config.json -> nodelink.password. NodeLink is reachable from the
# compose network only (no host port is published), but still pick something unguessable.
NODELINK_PASSWORD=change-me-nodelink
# Optional: git tag or commit of https://github.com/PerformanC/NodeLink to build (default v3.9.0).
# NODELINK_REF=v3.9.0

# --- Optional: commit shown by the bot (the image has no .git). CI passes the commit SHA. ---
# GIT_SHA=

# --- Timezone applied to all containers ---
TZ=UTC

# --- Optional: raw JSON config written to /app/config.json on first boot ---
# Takes precedence over docker/config_example.json when no config.json is mounted.
# CONFIG_JSON={"token":"YOUR_TOKEN","mysql":{"host":"mysql","port":3306,"user":"remix","password":"remix_pw","database":"remix"},"nodelink":{"host":"nodelink","port":3000,"password":"change-me-nodelink"}}
